# Isolated `fixit-test` Neon project — database integration tests only.
# Copy this file to .env.test and replace the placeholders locally. Never commit real values.
# The guard in tests/db/setup-db-env.ts accepts only the two exact fixit-test hostnames
# and refuses every other host (including development and production).

# Pooled connection assigned to DATABASE_URL at runtime by the DB test setup.
TEST_DATABASE_URL=postgresql://user:password@test-pooler-host/database?sslmode=require

# Direct/session connection used only by `prisma migrate deploy` during provisioning.
TEST_DIRECT_URL=postgresql://user:password@test-direct-host/database?sslmode=require

# Fail-closed opt-in. Must be exactly 1 to run DB tests or provisioning; never commit a value of 1.
RUN_DB_TESTS=0
