# Runtime
# Required, no default: development | test | production.
# Production refuses to start without GROQ_API_KEY and refuses to enable
# ALLOW_UNREVIEWED_KNOWLEDGE.
NODE_ENV=development
# Optional; defaults to 3000 when absent. Supplied values are validated.
PORT=3000
# Browser origins allowed by CORS. Native clients send no Origin and are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,exp://localhost:19000
# Swagger UI and /docs/openapi.json are disabled unless explicitly enabled.
ENABLE_API_DOCS=true
HEALTH_CHECK_TIMEOUT_MS=3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_MESSAGE_MAX=60

# PostgreSQL (Neon). DATABASE_URL is the pooled runtime connection;
# DIRECT_URL is the direct connection used by Prisma migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# Required only when running the development knowledge-base seed (`npm run db:seed`).
SEED_TARGET=development

# Auth. Generate a secret with:
# node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(48).toString('hex'))"
# This placeholder is intentionally shorter than 32 characters and must be replaced.
JWT_ACCESS_SECRET=replace-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Groq (AI). Backend-only credential; never expose it to the mobile app.
# Optional in development/test, but required when NODE_ENV=production.
GROQ_API_KEY=
# Tool-capable model used by the diagnosis agent. Configurable per environment.
# Start cost-conscious; set to openai/gpt-oss-120b only for manual quality comparison.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=1
GROQ_MAX_TOOL_ROUNDS=2
GROQ_MAX_TOOL_CALLS=3
GROQ_HISTORY_LIMIT=12
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_REASONING_EFFORT=low

# FIXED confirmation challenge lifetime.
FIX_CONFIRMATION_TTL_SECONDS=600

# Parts discovery is opt-in and disabled by default. groq_browser uses the Groq
# built-in browser_search tool, supported by openai/gpt-oss-20b and 120b.
# Browser search is not compatible with Structured Outputs; the diagnosis flow
# uses local function tools instead. No separate provider credential is needed.
# Allowed values: none | groq_browser
PARTS_PROVIDER=none
PARTS_ALLOWED_DOMAINS=samsung.com,lg.com,whirlpool.com,bosch-home.com,bosch.com,haier.com,partselect.com,repairclinic.com,appliancepartspros.com,searspartsdirect.com
PARTS_MAX_RESULTS=5

# Development-only access to UNREVIEWED knowledge. Defaults to false.
# Rejected at startup when NODE_ENV=production. Accepts only "true" or "false".
ALLOW_UNREVIEWED_KNOWLEDGE=false
