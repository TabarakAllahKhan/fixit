# Runtime
# Required, no default: development | test | production.
# Production refuses to start without GOOGLE_API_KEY and refuses to enable
# ALLOW_UNREVIEWED_KNOWLEDGE.
NODE_ENV=development
# Optional; defaults to 3000 when absent. Supplied values are validated.
PORT=3000
# Browser origins allowed by CORS. Native clients send no Origin and are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,exp://localhost:19000
# Swagger UI and /docs/openapi.json are disabled unless explicitly enabled.
ENABLE_API_DOCS=true
HEALTH_CHECK_TIMEOUT_MS=3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_MESSAGE_MAX=60

# PostgreSQL (Neon). DATABASE_URL is the pooled runtime connection;
# DIRECT_URL is the direct connection used by Prisma migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# Required only when running the development knowledge-base seed (`npm run db:seed`).
SEED_TARGET=development

# Auth. Generate a secret with:
# node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(48).toString('hex'))"
# This placeholder is intentionally shorter than 32 characters and must be replaced.
JWT_ACCESS_SECRET=replace-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google Gemini (production AI provider for diagnosis). Backend-only credential;
# never expose it to the mobile app. Required when NODE_ENV=production.
# The model is locked to the approved free-tier model; no paid fallback exists.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=3000
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_TOOL_ROUNDS=2
GEMINI_MAX_TOOL_CALLS=3
GEMINI_HISTORY_LIMIT=12
# Restricted follow-up window after a refused dangerous request, counted in
# prior USER turns (assistant messages are not counted) and independent of
# GEMINI_HISTORY_LIMIT. Accepted 1-50; the safety module never uses fewer than
# 6, so any value below 6 behaves as 6. Default 6.
SAFETY_FOLLOW_UP_USER_TURNS=6

# Legacy Groq settings. Used only by the opt-in `groq_browser` parts provider;
# GROQ_API_KEY is additionally required in production when that provider is enabled.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=1
GROQ_MAX_TOOL_ROUNDS=2
GROQ_MAX_TOOL_CALLS=3
GROQ_HISTORY_LIMIT=12
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_REASONING_EFFORT=low

# FIXED confirmation challenge lifetime.
FIX_CONFIRMATION_TTL_SECONDS=600

# Parts discovery is opt-in and disabled by default. groq_browser uses the Groq
# built-in browser_search tool, supported by openai/gpt-oss-20b and 120b.
# Browser search is not compatible with Structured Outputs; the diagnosis flow
# uses local function tools instead. No separate provider credential is needed.
# Allowed values: none | groq_browser
PARTS_PROVIDER=none
PARTS_ALLOWED_DOMAINS=samsung.com,lg.com,whirlpool.com,bosch-home.com,bosch.com,haier.com,partselect.com,repairclinic.com,appliancepartspros.com,searspartsdirect.com
PARTS_MAX_RESULTS=5
# Per-attempt timeout for the optional parts lookup (1000-60000 ms). Timed-out
# attempts are retried up to GROQ_MAX_RETRIES times, so the worst case is
# (1 + GROQ_MAX_RETRIES) x PARTS_TIMEOUT_MS (20000 ms with the defaults).
PARTS_TIMEOUT_MS=10000

# Backend web research is separate from parts discovery and disabled by default.
# Allowed values: none | groq_browser. groq_browser reuses GROQ_API_KEY/GROQ_MODEL
# and requires GROQ_API_KEY in production. The include_domains hint is not a
# security boundary; backend allowlist validation is authoritative.
# When enabled, diagnosis turns run at most one research call (no retry),
# skip it entirely on an immediate hazard, and reuse cached results while the
# brand/model/error-code/symptom research key is unchanged.
RESEARCH_PROVIDER=none
# Fetch allowlist only. Whether a site is the appliance's *own* manufacturer is
# decided by the reviewed brand mapping in src/utils/manufacturerDomains.ts.
RESEARCH_MANUFACTURER_DOMAINS=samsung.com,lg.com,whirlpool.com,bosch-home.com,bosch.com,haier.com,geappliances.com,whirlpool.ca,miele.com,electrolux.com,frigidaire.com,maytag.com,kitchenaid.com,daikin.com,rheem.com,aosmith.com,panasonic.com,global.sharp,sharpusa.com,beko.com
RESEARCH_TECHNICAL_DOMAINS=partselect.com,repairclinic.com,appliancepartspros.com,searspartsdirect.com
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_TITLE_LENGTH=160
RESEARCH_MAX_SNIPPET_LENGTH=360
RESEARCH_MAX_SERIALIZED_BYTES=20000
# Single-attempt research timeout (1000-30000 ms). Research is never retried.
RESEARCH_TIMEOUT_MS=8000

# Development-only access to UNREVIEWED knowledge. Defaults to false.
# Rejected at startup when NODE_ENV=production. Accepts only "true" or "false".
ALLOW_UNREVIEWED_KNOWLEDGE=false
